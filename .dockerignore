# Start from an allowlist: frontend, developer tools and private local files are
# never sent to the Docker builder. Only backend source and build inputs follow.
**
!.mvn/
!.mvn/settings.xml
!hoj-springboot/
!hoj-springboot/pom.xml
!hoj-springboot/api/
!hoj-springboot/api/pom.xml
!hoj-springboot/api/src/
!hoj-springboot/api/src/**
!hoj-springboot/DataBackup/
!hoj-springboot/DataBackup/pom.xml
!hoj-springboot/DataBackup/src/
!hoj-springboot/DataBackup/src/**
!hoj-springboot/JudgeServer/
!hoj-springboot/JudgeServer/pom.xml
!hoj-springboot/JudgeServer/src/
!hoj-springboot/JudgeServer/src/**
!docker/
!docker/backend.Dockerfile
!docker/backend-entrypoint.sh
!docker/backend-healthcheck.sh
!docker/backend-tests.txt
!docker/NacosPasswordHash.java
!docker/frontend.Dockerfile
!docker/frontend.conf.template
!docker/frontend-app.conf.template
!docker/frontend-tls.conf.template
!docker/frontend-env.envsh
!hoj-vue/
!hoj-vue/package.json
!hoj-vue/package-lock.json
!hoj-vue/babel.config.js
!hoj-vue/vue.config.js
!hoj-vue/public/
!hoj-vue/public/**
!hoj-vue/src/
!hoj-vue/src/**
!hoj-vue/tests/
!hoj-vue/tests/**
!hoj-scrollBoard/
!hoj-scrollBoard/**

# Re-exclude sensitive/generated files even when placed underneath source dirs.
**/.env
**/.env.*
**/.git
**/.tools
**/.aws
**/.ssh
**/.codex
**/.agents
**/.idea
**/.vscode
**/.run
**/node_modules
**/target
**/dist
**/logs
**/*.log
**/*.log.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.sql
**/*.dump
**/*.zip
**/*.tar
**/*.gz
**/*.xls
**/*.xlsx
**/*.doc
**/*.docx
**/*.pdf
