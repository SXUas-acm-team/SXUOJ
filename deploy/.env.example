# Optional runtime overrides for the backend. Keep the existing values on upgrades.
# Copy to backend.env (git-ignored) and import with --runtime-env /absolute/backend.env.
# Compose env-file syntax: single-quote values containing a literal $ or #.
# Do not change JUDGE_TOKEN independently of the running JudgeServer/Nacos configuration.

# JWT_TOKEN_SECRET='existing-base64-key-with-at-least-64-random-bytes'
# JUDGE_TOKEN='existing-shared-judge-token-at-least-32-characters'
# NACOS_PASSWORD='existing-nacos-account-password'
# MYSQL_PASSWORD='existing-database-password'
# REDIS_PASSWORD='existing-redis-password'

# JAVA_OPTS=-Xms192m -Xmx768m
# BACKEND_SERVER_PORT=6688
# SPRING_PROFILES_ACTIVE=prod
# NACOS_ENABLED=true
# NACOS_URL=172.20.0.4:8848
# NACOS_USERNAME=root
# MYSQL_HOST=172.20.0.3
# MYSQL_PORT=3306
# MYSQL_PUBLIC_HOST=172.20.0.3
# MYSQL_PUBLIC_PORT=3306
# MYSQL_USERNAME=root
# MYSQL_DATABASE_NAME=hoj
# REDIS_HOST=172.20.0.2
# REDIS_PORT=6379
# EMAIL_SERVER_HOST=smtp.qq.com
# EMAIL_SERVER_PORT=465
# EMAIL_USERNAME=...
# EMAIL_PASSWORD='...'
# HOJ_TRUSTED_PROXIES=127.0.0.1,::1
