server {
    listen 443 ssl;
    server_name ${SERVER_NAME};
    server_tokens off;
    ssl_certificate ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }
    include /etc/nginx/snippets/sxuoj-app.conf;
}
